<div class="container-fluid">
  <div class="card mb-4">

    <div class="card-header d-flex align-items-center">
      <h3 class="card-title mb-0">
        <i class="ti ti-mail-forward me-2"></i>
        {{ __('Send bulk email', 'mailblast') }}
      </h3>
      {% if can_config %}
      <a href="{{ plugin_web_dir }}/front/config.php"
         class="btn btn-sm btn-outline-secondary ms-auto">
        <i class="ti ti-settings me-1"></i>{{ __('Configuration', 'mailblast') }}
      </a>
      {% endif %}
    </div>

    <div class="card-body">
      <form id="mb_sendForm" method="post" action="{{ form_action }}" enctype="multipart/form-data">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

        <div id="mb_formAlert" class="alert alert-danger py-2 mb-3" style="display:none" role="alert"></div>

        <div class="d-flex align-items-center mb-3">
          <h4 class="mb-0">
            <i class="ti ti-pencil me-1"></i>
            {{ __('Compose message', 'mailblast') }}
          </h4>
          <button type="button" id="mb_clearForm" class="btn btn-sm btn-outline-secondary ms-auto">
            <i class="ti ti-eraser me-1"></i>{{ __('Clear form', 'mailblast') }}
          </button>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold d-flex justify-content-between align-items-center" for="mb_subject">
            <span>
              {{ __('Subject', 'mailblast') }}
              <span class="text-danger">*</span>
            </span>
            <span id="mb_subjectCounter" class="small text-muted fw-normal">
              {{ saved_form.subject | length }}/250
            </span>
          </label>
          <input id="mb_subject" type="text" name="subject" class="form-control"
                 maxlength="250" value="{{ saved_form.subject }}" required>
          <div class="form-text text-muted">
            {{ __('Available placeholders: {nombre}, {nombre_completo}, {email}', 'mailblast') }}
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold" for="{{ mb_body_id }}">
            {{ __('Message body', 'mailblast') }}
            <span class="text-danger">*</span>
          </label>
          {{ editor_html | raw }}
        </div>

        <div class="mb-4">
          <label class="form-label fw-bold" for="mb_footer">
            {{ __('Footer', 'mailblast') }}
          </label>
          <div class="border rounded" style="overflow:hidden">
            <div class="d-flex gap-1 p-1 border-bottom" id="mb_footerToolbar">
              <button type="button" class="btn btn-sm btn-ghost-secondary fw-bold px-2" data-cmd="bold"
                title="{{ __('Bold', 'mailblast') }}"><b>N</b></button>
              <button type="button" class="btn btn-sm btn-ghost-secondary fst-italic px-2" data-cmd="italic"
                title="{{ __('Italic', 'mailblast') }}"><i>C</i></button>
              <button type="button" class="btn btn-sm btn-ghost-secondary px-2" data-cmd="underline"
                title="{{ __('Underline', 'mailblast') }}" style="text-decoration:underline">S</button>
            </div>
            <div id="mb_footerEdit" contenteditable="true" spellcheck="true" class="p-2"
                 style="min-height:80px;outline:none;font-family:inherit;font-size:inherit;line-height:1.5;white-space:pre-wrap;word-break:break-word"
            >{{ footer_html | raw }}</div>
            <textarea name="footer" id="mb_footer" class="d-none"></textarea>
          </div>
        </div>

        <hr class="my-4">

        <h4 class="mb-3">
          <i class="ti ti-paperclip me-1"></i>
          {{ __('Attachments', 'mailblast') }}
        </h4>

        <p class="text-muted mb-2 small">
          <i class="ti ti-shield-check me-1 text-success"></i>
          {{ __('Only file types allowed by GLPI are accepted', 'mailblast') }}
        </p>

        {% if doc_types.types is not empty %}
        <div class="mb-3">
          <a class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse"
             href="#mb_allowedTypes" role="button" aria-expanded="false">
            <i class="ti ti-list me-1"></i>
            {{ __('View allowed file types', 'mailblast') }}
            <span style="background:#2fb344;color:#fff;padding:.15rem .45rem;border-radius:20px;font-size:.75rem;font-weight:700;margin-left:.25rem">{{ doc_types.types | length }}</span>
          </a>
          <div class="collapse mt-2" id="mb_allowedTypes">
            <div class="border rounded p-2" style="max-height:180px;overflow-y:auto">
              <div class="row row-cols-2 row-cols-md-4 g-1">
                {% for t in doc_types.types %}
                  <div class="col">
                    <span class="mb-badge-type w-100 text-start">
                      <code class="me-1">.{{ t.ext }}</code>
                      <small class="text-muted">{{ t.name }}</small>
                    </span>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
        {% endif %}

        <div id="mb_dropZone"
             class="mb-2 rounded border border-2 border-dashed d-flex flex-column align-items-center justify-content-center gap-2 p-4"
             style="cursor:pointer;min-height:120px;border-color:var(--tblr-border-color)!important;transition:background .15s">
          <i class="ti ti-cloud-upload fs-1 text-muted"></i>
          <p class="mb-0 text-muted">
            {{ __('Drag & drop files here or', 'mailblast') }}
            <span class="text-primary text-decoration-underline" style="cursor:pointer" id="mb_browseLabel">
              {{ __('browse', 'mailblast') }}
            </span>
          </p>
          <p class="mb-0 small text-muted" id="mb_acceptHint">{{ ext_hints_str }}</p>
          <input id="mb_fileInput" type="file" name="attachments[]" multiple
                 accept="{{ doc_types.accept }}" class="d-none">
        </div>

        <ul id="mb_fileList" class="list-group mb-2" style="display:none!important"></ul>

        <p class="small text-muted mb-4">
          <i class="ti ti-weight me-1"></i>
          {{ __('Maximum combined attachment size', 'mailblast') }}:
          <strong>{{ max_att_mb }} MB</strong>
        </p>

        <hr class="my-4">

        <h4 class="mb-3">
          <i class="ti ti-flask me-1"></i>
          {{ __('Test email', 'mailblast') }}
        </h4>

        <div class="mb-3">
          <div class="form-check mb-2">
            <input class="form-check-input" type="radio" name="test_mode"
                   id="mb_testMe" value="my_address" checked>
            <label class="form-check-label" for="mb_testMe">
              {{ __('Send to my address (administrator)', 'mailblast') }}
              {% if my_email %}
                <span class="mb-email-badge ms-1">{{ my_email }}</span>
              {% endif %}
            </label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="test_mode"
                   id="mb_testSpecific" value="specific">
            <label class="form-check-label" for="mb_testSpecific">
              {{ __('Send to a specific address', 'mailblast') }}
            </label>
          </div>
        </div>

        <div id="mb_testEmailField" class="mb-3" style="display:none;max-width:480px">
          <label class="form-label fw-bold" for="mb_testEmail">
            {{ __('Test address', 'mailblast') }}
          </label>
          <input id="mb_testEmail" type="text" name="test_email" class="form-control"
                 placeholder="{{ __('user@company.com, other@company.com', 'mailblast') }}"
                 autocomplete="off">
          <div class="form-text text-muted">
            {{ __('Separate multiple addresses with commas. Maximum 5 addresses.', 'mailblast') }}
          </div>
        </div>

        <div class="mb-4">
          <button type="button" id="mb_sendTest" class="btn btn-secondary">
            <i class="ti ti-send me-1"></i>
            {{ __('Send test email', 'mailblast') }}
          </button>
        </div>

        <hr class="my-4">

        <h4 class="mb-3">
          <i class="ti ti-users me-1"></i>
          {{ __('Mass mailing', 'mailblast') }}
        </h4>

        <div class="mb-3">
          <label class="form-label fw-bold">{{ __('Send to', 'mailblast') }}</label>
          <div class="d-flex flex-column gap-1">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="filter_type" id="mb_filterAll" value="all" checked>
              <label class="form-check-label" for="mb_filterAll">{{ __('All active users', 'mailblast') }}</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="filter_type" id="mb_filterEntitiesRadio" value="entities">
              <label class="form-check-label" for="mb_filterEntitiesRadio">{{ __('Specific organizations', 'mailblast') }}</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="filter_type" id="mb_filterProfilesRadio" value="profiles">
              <label class="form-check-label" for="mb_filterProfilesRadio">{{ __('Specific profiles', 'mailblast') }}</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="filter_type" id="mb_filterUsersRadio" value="users">
              <label class="form-check-label" for="mb_filterUsersRadio">{{ __('Specific users', 'mailblast') }}</label>
            </div>
          </div>
        </div>

        <div id="mb_filterEntitiesBox" class="mb-3" style="display:none;max-width:520px">
          <label class="form-label" for="mb_entitySelect">{{ __('Select organizations', 'mailblast') }}</label>
          <select id="mb_entitySelect" multiple class="form-select" size="5" style="max-height:180px">
            {% for e in entities %}
              <option value="{{ e.id }}">{{ e.name }}</option>
            {% endfor %}
          </select>
          <div class="form-text text-muted">{{ __('Hold Ctrl / Cmd to select multiple.', 'mailblast') }}</div>
        </div>

        <div id="mb_filterProfilesBox" class="mb-3" style="display:none;max-width:520px">
          <label class="form-label" for="mb_profileSelect">{{ __('Select profiles', 'mailblast') }}</label>
          <select id="mb_profileSelect" multiple class="form-select" size="5" style="max-height:180px">
            {% for p in profiles %}
              <option value="{{ p.id }}">{{ p.name }}</option>
            {% endfor %}
          </select>
          <div class="form-text text-muted">{{ __('Hold Ctrl / Cmd to select multiple.', 'mailblast') }}</div>
        </div>

        <div id="mb_filterUsersBox" class="mb-3" style="display:none;max-width:520px">
          <label class="form-label" for="mb_userSelect">{{ __('Select users', 'mailblast') }}</label>
          <select id="mb_userSelect" multiple class="form-select" size="6" style="max-height:200px">
            {% for u in users %}
              <option value="{{ u.id }}">{{ u.name }} &lt;{{ u.email }}&gt;</option>
            {% endfor %}
          </select>
          <div class="form-text text-muted">{{ __('Hold Ctrl / Cmd to select multiple.', 'mailblast') }}</div>
        </div>

        {% if entities_with_email is not empty %}
        <div class="mb-3" style="max-width:480px">
          <label class="form-label fw-bold" for="mb_fromEntity">{{ __('Send from', 'mailblast') }}</label>
          <select id="mb_fromEntity" class="form-select">
            <option value="0">{{ __('Default (GLPI configuration)', 'mailblast') }}</option>
            {% for e in entities_with_email %}
              <option value="{{ e.id }}">{{ e.name }} ({{ e.email }})</option>
            {% endfor %}
          </select>
        </div>
        {% endif %}

        <p class="mb-3 d-flex align-items-center gap-2">
          <i class="ti ti-circle-check text-success fs-4" id="mb_recipientIcon"{% if user_count == 0 %} style="display:none"{% endif %}></i>
          <i class="ti ti-alert-triangle text-warning fs-4" id="mb_recipientWarnIcon"{% if user_count > 0 %} style="display:none"{% endif %}></i>
          <span>
            {{ __('Active users with registered email', 'mailblast') }}:
            <span class="badge mb-count-badge ms-1" id="mb_recipientCount">{{ user_count }}</span>
          </span>
        </p>

        <button type="button" class="btn btn-danger" id="mb_sendAll"
                {{ user_count == 0 ? 'disabled' : '' }}>
          <i class="ti ti-mail-forward me-1"></i>
          {{ __('Send to selected recipients', 'mailblast') }}
        </button>

        {# Confirmation modal #}
        <div class="modal fade" id="mb_confirmModal" tabindex="-1"
             data-bs-backdrop="static" data-bs-keyboard="false"
             aria-labelledby="mb_confirmLabel" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="mb_confirmLabel">
                  <i class="ti ti-mail-forward me-2 text-danger"></i>
                  {{ __('Confirm send', 'mailblast') }}
                </h5>
              </div>
              <div class="modal-body">
                <p class="mb-2">{{ __('You are about to send an email to', 'mailblast') }}:</p>
                <div class="d-flex align-items-center gap-3 p-3 rounded border">
                  <i class="ti ti-users fs-1 text-danger flex-shrink-0"></i>
                  <div>
                    <div class="fw-bold fs-3 lh-1" id="mb_confirmCount">{{ user_count }}</div>
                    <div class="text-muted small mt-1">{{ __('Active users with registered email', 'mailblast') }}</div>
                  </div>
                </div>
                <p class="mt-3 mb-0 text-muted small">
                  <i class="ti ti-info-circle me-1"></i>
                  {{ __('This action cannot be undone. Each recipient will receive one email.', 'mailblast') }}
                </p>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                  {{ __('Cancel', 'mailblast') }}
                </button>
                <button type="button" class="btn btn-danger" id="mb_confirmSend">
                  <i class="ti ti-send me-1"></i>
                  {{ __('Yes, send now', 'mailblast') }}
                </button>
              </div>
            </div>
          </div>
        </div>

        <div id="mb_summaryBanner" class="alert mb-3" style="display:none" role="alert"></div>

        {# Progress modal #}
        <div class="modal fade" id="mb_progressModal" tabindex="-1"
             data-bs-backdrop="static" data-bs-keyboard="false"
             aria-labelledby="mb_progressLabel" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="mb_progressLabel">
                  <i class="ti ti-mail-forward me-2"></i>
                  {{ __('Sending emails', 'mailblast') }}
                </h5>
              </div>
              <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="text-muted small">{{ __('Progress', 'mailblast') }}</span>
                  <span class="small fw-bold" id="mb_progressLabel2">0 / 0</span>
                </div>
                <div class="progress mb-3" style="height:22px;border-radius:6px">
                  <div id="mb_progressBar"
                       class="progress-bar progress-bar-striped progress-bar-animated fw-semibold"
                       role="progressbar" style="width:0%;font-size:.8rem"
                       aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
                </div>
                <div class="row text-center g-2 mb-3">
                  <div class="col-4">
                    <div class="text-success fw-bold fs-3" id="mb_countSent">0</div>
                    <div class="text-muted small">{{ __('Sent', 'mailblast') }}</div>
                  </div>
                  <div class="col-4">
                    <div class="text-danger fw-bold fs-3" id="mb_countError">0</div>
                    <div class="text-muted small">{{ __('Errors', 'mailblast') }}</div>
                  </div>
                  <div class="col-4">
                    <div class="text-warning fw-bold fs-3" id="mb_countPending">0</div>
                    <div class="text-muted small">{{ __('Pending', 'mailblast') }}</div>
                  </div>
                </div>
                <div class="text-muted small text-center mb-2">
                  <i class="ti ti-clock me-1"></i>
                  {{ __('Elapsed', 'mailblast') }}:
                  <span id="mb_elapsed">0s</span>
                </div>
                <div id="mb_statusLine" class="alert py-2 small mb-3" style="display:none"></div>
                <div id="mb_errorSection" style="display:none">
                  <hr class="my-2">
                  <p class="text-danger small fw-semibold mb-1">
                    <i class="ti ti-alert-triangle me-1"></i>
                    {{ __('Failed addresses', 'mailblast') }}
                  </p>
                  <ul id="mb_errorList" class="list-unstyled small text-danger mb-0"
                      style="max-height:120px;overflow-y:auto"></ul>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" id="mb_cancelSend">
                  <i class="ti ti-x me-1"></i>
                  {{ __('Cancel', 'mailblast') }}
                </button>
                <button type="button" class="btn btn-outline-success d-none" id="mb_downloadReport">
                  <i class="ti ti-file-spreadsheet me-1"></i>
                  {{ __('Download report', 'mailblast') }}
                </button>
                <button type="button" class="btn btn-primary d-none" id="mb_closeProgress"
                        data-bs-dismiss="modal">
                  {{ __('Close', 'mailblast') }}
                </button>
              </div>
            </div>
          </div>
        </div>

      </form>
    </div>
  </div>
</div>

<style>
#mb_dropZone.dragover {
  background: rgba(var(--tblr-primary-rgb), .07) !important;
  border-color: var(--tblr-primary) !important;
}
.mb-badge-type {
  display: inline-flex; align-items: center; gap: .25rem;
  padding: .25rem .45rem;
  border-radius: var(--tblr-border-radius-sm, 4px);
  font-size: .75rem; color: var(--tblr-body-color);
  border: 1px solid var(--tblr-border-color); line-height: 1.3;
}
.mb-badge-type code { color: var(--tblr-body-color); background: none; padding: 0; font-size: inherit; font-weight: 700; }
.mb-badge-type small { color: var(--tblr-muted, var(--tblr-secondary)); }
.mb-email-badge {
  display: inline-block; padding: .2rem .55rem;
  border-radius: var(--tblr-border-radius-sm, 4px);
  font-size: .75rem; font-weight: 500;
  background-color: var(--tblr-primary); color: #fff;
  vertical-align: middle; word-break: break-all;
}
.mb-count-badge {
  display: inline-block; padding: .15rem .5rem;
  border-radius: 20px; font-size: .8rem; font-weight: 700;
  background-color: #2fb344; color: #fff !important;
  vertical-align: middle; line-height: 1.4;
}
</style>

{# JS is inlined by PHP after this template — no <script src> needed #}
